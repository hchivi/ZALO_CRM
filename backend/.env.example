HOST=0.0.0.0
PORT=3081
NODE_ENV=development
APP_URL=http://localhost:3000

# Standalone mode (false = chạy độc lập không cần Portal)
PORTAL_MANAGED=false
ZALO_AUTOCONNECT=true

# Security keys (tạo bằng: openssl rand -hex 32 và openssl rand -hex 16)
JWT_SECRET=change-this-to-a-random-64-char-hex-secret
ENCRYPTION_KEY=change-this-32-char-hex-key-1234

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/zalocrm

# Upload directory
UPLOAD_DIR=./uploads
